         RowBox[{"-", "1."}], ",", " ", "1."}], "}"}]}], "]"}], "]"}], " ", "*",
     " ", 
    RowBox[{"180.", " ", "/", " ", "\[Pi]"}]}]}], ";"}]}], "Input",
