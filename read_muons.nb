Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rlat", " ", "=", " ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"xf", "^", "2"}], " ", "+", " ", 
       RowBox[{"yf", "^", "2"}]}], "]"}], " ", "/", " ", "100."}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"th0", " ", "=", " ", 
   RowBox[{
    RowBox[{"ArcCos", "[", "cth0", "]"}], " ", "*", " ", 
    RowBox[{"180.", " ", "/", " ", "\[Pi]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thf", " ", "=", " ", 
   RowBox[{
    RowBox[{"ArcCos", "[", 
     RowBox[{"Clip", "[", 
      RowBox[{"czf", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1."}], ",", " ", "1."}], "}"}]}], "]"}], "]"}], " ", "*",
     " ", 
    RowBox[{"180.", " ", "/", " ", "\[Pi]"}]}]}], ";"}]}], "Input",
