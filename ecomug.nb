Cell[CellGroupData[{

Cell["\<\
This is a one dimensional calculation of the flux at some shallow depth \
(argument depth is in meters).  It uses an average energy loss and computes \
the flux according to the surface flux for the corresponding surface energy \
of the muon.  The slant depth is calculated according to the polar angle and \
a flat surface. No accounting for earth\[CloseCurlyQuote]s curvature, \
multiple scattering, or energy loss fluctuations are done.  This calculation \
is only good for modest depths of a few hundred meters.  \
\>", "Subtitle",
 CellChangeTimes->{{3.988190232656165*^9, 3.988190257324815*^9}, {
  3.988190381705716*^9, 3.988190388376786*^9}, {3.988190432053712*^9, 
  3.988190449479444*^9}, {3.988190544480364*^9, 3.988190551681573*^9}, {
  3.9881911976658278`*^9, 3.9881912437631483`*^9}, {3.988191295548789*^9, 
  3.988191393134019*^9}},ExpressionUUID->"eb2d9f05-2243-4ab5-b517-\
9d7d91f2cee5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DmuShallow2", "[", 
   RowBox[{"emu_", ",", "x_", ",", " ", "depth_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "aave", ",", "  ", "slantdepth", ",", " ", "eloss", " ", ",", " ", 
      "esurf", ",", " ", "tmp", ",", " ", "costh"}], " ", "}"}], ",", " ", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"aave", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"apar", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{"apar", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", "2"}]}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"This", " ", "is", " ", "in", " ", 
       RowBox[{
        RowBox[{"MeV", "/", "gm"}], "/", 
        RowBox[{"cm", "^", "2"}]}]}], " ", "*)"}], "  ", 
     "\[IndentingNewLine]", 
     RowBox[{"slantdepth", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"x", ">", "0"}], ",", " ", 
        RowBox[{"100", "*", 
         RowBox[{"depth", "/", "x"}]}], ",", " ", "12742000"}], "]"}]}], ";", 
     "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "this", " ", "is", " ", "in", " ", "meters", " ", "Set", " ", "maximum",
        " ", "to", " ", "be", " ", 
       RowBox[{"Earth", "'"}], "s", " ", "diameter"}], " ", "*)"}], "  ", 
     "\[IndentingNewLine]", 
     RowBox[{"density", " ", "=", " ", "1.0"}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"just", " ", "use", " ", "water", " ", "for", " ", "now"}], " ",
       "*)"}], "  ", "\[IndentingNewLine]", 
     RowBox[{"eloss", " ", "=", 
      RowBox[{"aave", "*", "density", "*", "slantdepth", " ", "*", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "3"}]}]}]}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "this", " ", "is", " ", "to", " ", "get", " ", "it", " ", "into", " ", 
       "GeV"}], " ", "*)"}], "  ", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "eloss", "]"}], ";"}], " ", "*)"}], " ", 
     "\[IndentingNewLine]", 
     RowBox[{"esurf", " ", "=", " ", 
      RowBox[{"emu", " ", "+", " ", "eloss"}]}], ";", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"this", " ", "should", " ", "be", " ", "in", " ", "GeV"}], " ", 
      "*)"}], "  ", "\[IndentingNewLine]", 
     RowBox[{"costh", " ", "=", " ", "x"}], ";", " ", "\[IndentingNewLine]", 
     RowBox[{"tmp", " ", "=", " ", 
      RowBox[{"dalt", "[", 
       RowBox[{"esurf", ",", " ", "costh"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "tmp", "]"}], ";"}]}], " ", "\[IndentingNewLine]",
    "   ", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.981134238785294*^9, 3.981134246721055*^9}, {
  3.982864052706172*^9, 3.9828640611059937`*^9}, {3.982864144481845*^9, 
  3.982864168686543*^9}, {3.982864201531065*^9, 3.9828642433350697`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"8ffad640-6201-4809-a16a-fbabcb5ec6c6"],

Cell[CellGroupData[{

Cell["\<\
Muon spectrum at 200 meters depth for vertical and at 75 degrees.  \
\>", "Subsection",
 CellChangeTimes->{{3.98819143767868*^9, 
  3.988191457091216*^9}},ExpressionUUID->"513c682b-2707-4817-9636-\
69af64e4ab61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pdeep", "=", " ", 
  RowBox[{"LogLogPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"DmuShallow2", "[", 
       RowBox[{"emu", ",", "1.", " ", ",", " ", "200."}], "]"}], ",", "  ", 
      RowBox[{"DmuShallow2", "[", 
       RowBox[{"emu", ",", "0.25", ",", " ", "200."}], "]"}]}], " ", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"emu", ",", "0.05", ",", " ", "20000"}], " ", "}"}], ",", " ", 
    RowBox[{"Frame", " ", "->", " ", "True"}], " ", ",", " ", 
    RowBox[{"LabelStyle", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"Bold", ",", " ", "Large", ",", " ", "Italic"}], "}"}]}], " ", ",",
     " ", 
    RowBox[{"FrameLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<energy GeV\>\"", ",", 
       " ", "\"\<Muons m^-2 sr^-1 sec^-1 GeV^-1\>\""}], " ", "}"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.988195284864694*^9, 3.988195340182539*^9}, {
  3.98819540454071*^9, 3.988195406375115*^9}, {3.988195442234798*^9, 
