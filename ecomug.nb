Cell[CellGroupData[{

Cell["\<\
Now we will work on generation of muons from the top surface and side surface \
at some depth. For this we need to use the appropriate PDFs. We will use the \
Metropolis algorithm with two dimensions.  The idea is to only produce the \
polar angle and the momentum and provide in a file. The location on the \
horizontal surface can be generated uniformly. The azimuthal angle can be \
generated uniformly also if there is no effect of magnetic field. 
The PDF needs to have limits using the UnitStep function to make sure \
generation is between 1 - 100 GeV and polar angle Cos(th) of 0 to 1.  We will \
use x = cos(th) for generation.  The correct PDF is the projection of the \
flux on the horizontal surface.  \
\>", "Subsubsection",
 CellChangeTimes->{{3.9881938604964733`*^9, 3.988193900156638*^9}, {
  3.988194945736251*^9, 
  3.988194947302478*^9}},ExpressionUUID->"b0fef48d-653e-4737-9f82-\
45900a7ef10c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"depth", " ", "=", " ", "188"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"horpdf", "[", 
     RowBox[{"pmu_", ",", "x_"}], "]"}], ":=", " ", 
    RowBox[{"2", " ", "*", " ", "Pi", "*", " ", 
     RowBox[{"DmuShallow2", "[", 
      RowBox[{"pmu", ",", " ", "x", ",", "depth"}], "]"}], "*", "x", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"UnitStep", "[", "x", "]"}], "-", 
       RowBox[{"UnitStep", "[", 
        RowBox[{"x", "-", "1"}], "]"}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"UnitStep", "[", 
        RowBox[{"pmu", "-", "1"}], "]"}], "-", 
       RowBox[{"UnitStep", "[", 
        RowBox[{"pmu", "-", "100"}], "]"}]}], ")"}]}]}], ";"}], 
  " "}]}], "Input",
 CellChangeTimes->{{3.982863477268281*^9, 3.982863521598914*^9}, {
   3.982863556742159*^9, 3.9828635784621773`*^9}, 3.9828637096997013`*^9, {
   3.982863866346233*^9, 3.982863872152512*^9}, {3.982864449446538*^9, 
   3.9828644547219954`*^9}, {3.9828644916019173`*^9, 3.982864521402279*^9}, {
   3.988194150755177*^9, 3.988194159836094*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"d50fef1a-9001-4a51-b82b-9e1576c56b5f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ntrials", " ", "=", " ", "250000"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xmu", " ", "=", "  ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "Ntrials"}], "}"}]}], "]"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xmu", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"1.", ",", "0.999"}], "}"}]}], " ", ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"just", " ", "an", " ", "initial", " ", "guess"}], " ", "*)"}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mypdf", "[", "x_", "]"}], ":=", " ", 
    RowBox[{"horpdf", "[", 
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
      RowBox[{"x", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "we", " ", "just", " ", "need", " ", "a", " ", "function", " ", "that", " ",
     "is", " ", "proportional", " ", "to", " ", "the", " ", "TARGET", " ", 
    "PDF", " ", "pass", " ", "the", " ", "parameter", " ", "as", " ", "a", " ",
     "2", "vector"}], "*)"}], " "}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<", " ", "Ntrials"}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"(*", " ", 
    RowBox[{"go", " ", "through", " ", "all", " ", "trials"}], " ", "*)"}], 
   "  ", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"xnew", " ", "=", " ", 
     RowBox[{
      RowBox[{"xmu", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "+", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"RandomReal", "[", "]"}], " ", "-", "0.5"}], " ", ")"}], "*",
          "10."}], " ", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"RandomReal", "[", "]"}], " ", "-", "0.5"}], ")"}], "*", 
         "0.1"}]}], " ", "}"}]}]}], "  ", ";", "  ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"get", " ", "a", " ", "new", " ", "number", " ", "within"}], 
      " ", "+", 
      RowBox[{
       RowBox[{"-", " ", "0.25"}], " ", "of", " ", "the", " ", 
       RowBox[{"previous", ".", "  ", "Try"}], " ", "it", " ", "with", " ", 
       "a", " ", "smaller", " ", "or", " ", "larger", " ", "number"}]}], " ", 
     "*)"}], "  ", "\n", "  ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"xnew", " ", "=", " ", 
       RowBox[{
        RowBox[{"xg", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", "1"}], "]"}], "]"}], "*", "0.05"}]}]}], ";"}], 
     " ", "*)"}], 
    RowBox[{"(*", " ", 
     RowBox[{"Try", " ", "it", " ", "this", " ", 
      RowBox[{"way", ".", " ", "It"}], " ", "does", " ", "not", " ", "matter",
       " ", "what", " ", "the", " ", "initial", " ", "PDF", " ", "is"}], "  ",
      "*)"}], "  ", "\[IndentingNewLine]", 
    RowBox[{"If", " ", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"RandomReal", "[", "]"}], "<", 
       RowBox[{"Min", "[", 
        RowBox[{"1", ",", 
         RowBox[{
          RowBox[{"mypdf", "[", "xnew", "]"}], "/", 
          RowBox[{"mypdf", "[", 
           RowBox[{"xmu", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xmu", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", "xnew"}], ",", " ", 
      RowBox[{
       RowBox[{"xmu", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
       RowBox[{"xmu", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.982864787926407*^9, 3.9828648707489347`*^9}, {
   3.982864932533308*^9, 3.982865011857877*^9}, {3.982865465863139*^9, 
   3.9828655102943363`*^9}, {3.982865564637841*^9, 3.98286556620617*^9}, {
   3.982865834606534*^9, 3.982865834981041*^9}, {3.982866123861094*^9, 
