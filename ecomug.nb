Cell[BoxData[Cell["\<\
Now we do this for the vertical plane.  Or muons from the side. No muons \
should come below the horizon or x = 0.  This is a little bit tricky for the \
azimuthal angle. For depth use  the midpoint of the sides.   And so,  we \
generate the position on the vertical plane uniformly (although the flux \
should drop from top to bottom, we will assume that the drop is small) .  \
Then we generate the azimuthal according to   cos(phi) with respect to the \
normal to the plane.  Notice that the polar angle dependence is in x = \
cos(th).      There is only 1 power of sin(th) since the generation is in x \
and not in theta.   This will provide the projection of the flux on the \
vertical surface.  \
\>", "Subsection",
  CellChangeTimes->{{3.982872771014843*^9, 3.982872836023361*^9}, {
   3.982873870707364*^9, 3.982873891684936*^9}, {3.982874129589588*^9, 
   3.982874235518935*^9}, {3.9828742850606937`*^9, 3.982874313466947*^9}, {
   3.982874343604295*^9, 3.98287439287626*^9}},ExpressionUUID->
  "d416964f-479a-4503-8b4c-f9808dbc8a7a"]], "Input",
 CellChangeTimes->{{3.98819402272011*^9, 3.988194087818639*^9}, {
  3.9881941919148493`*^9, 
  3.9881942059089622`*^9}},ExpressionUUID->"1b911365-c796-4695-959e-\
aad3c1ed82c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"depth", " ", "=", " ", "198"}], ";"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"vertpdf", "[", 
     RowBox[{"pmu_", ",", "x_"}], "]"}], " ", ":=", "  ", 
    RowBox[{"2", "*", 
     RowBox[{"DmuShallow2", "[", 
      RowBox[{"pmu", ",", " ", "x", ",", "depth"}], "]"}], "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"x", "^", "2"}]}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"UnitStep", "[", "x", "]"}], "-", 
       RowBox[{"UnitStep", "[", 
        RowBox[{"x", "-", "1"}], "]"}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"UnitStep", "[", 
        RowBox[{"pmu", "-", "1"}], "]"}], "-", 
       RowBox[{"UnitStep", "[", 
        RowBox[{"pmu", "-", "100"}], "]"}]}], ")"}]}]}], ";"}], 
  " "}]}], "Input",
 CellChangeTimes->{{3.988194135838752*^9, 3.988194147171392*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"3b55c14c-f70c-4622-83d7-8055f81f4482"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ntrials", " ", "=", " ", "250000"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xmu", " ", "=", "  ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "Ntrials"}], "}"}]}], "]"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xmu", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"1.", ",", "0.999"}], "}"}]}], " ", ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"just", " ", "an", " ", "initial", " ", "guess"}], " ", "*)"}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mypdf", "[", "x_", "]"}], ":=", " ", 
    RowBox[{"vertpdf", "[", 
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
      RowBox[{"x", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "we", " ", "just", " ", "need", " ", "a", " ", "function", " ", "that", " ",
     "is", " ", "proportional", " ", "to", " ", "the", " ", "TARGET", " ", 
    "PDF", "   ", "pass", " ", "the", " ", "parameter", " ", "as", " ", "a", " ",
     "2", "vector"}], "*)"}], " "}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<", " ", "Ntrials"}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"(*", " ", 
    RowBox[{"go", " ", "through", " ", "all", " ", "trials"}], " ", "*)"}], 
   "  ", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"xnew", " ", "=", " ", 
     RowBox[{
      RowBox[{"xmu", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "+", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"RandomReal", "[", "]"}], " ", "-", "0.5"}], " ", ")"}], "*",
          "10."}], " ", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"RandomReal", "[", "]"}], " ", "-", "0.5"}], ")"}], "*", 
         "0.1"}]}], " ", "}"}]}]}], "  ", ";", "  ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"get", " ", "a", " ", "new", " ", "number", " ", "within"}], 
      " ", "+", 
      RowBox[{
       RowBox[{"-", " ", "0.25"}], " ", "of", " ", "the", " ", 
       RowBox[{"previous", ".", "  ", "Try"}], " ", "it", " ", "with", " ", 
       "a", " ", "smaller", " ", "or", " ", "larger", " ", "number"}]}], " ", 
     "*)"}], "  ", "\n", "  ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"xnew", " ", "=", " ", 
       RowBox[{
        RowBox[{"xg", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", "1"}], "]"}], "]"}], "*", "0.05"}]}]}], ";"}], 
     " ", "*)"}], 
    RowBox[{"(*", " ", 
     RowBox[{"Try", " ", "it", " ", "this", " ", 
      RowBox[{"way", ".", " ", "It"}], " ", "does", " ", "not", " ", "matter",
       " ", "what", " ", "the", " ", "initial", " ", "PDF", " ", "is"}], "  ",
      "*)"}], "  ", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"xnew", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ">", "1"}], ",", " ", 
      RowBox[{
       RowBox[{"xnew", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "=", "1"}]}], "]"}], ";", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"If", " ", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"RandomReal", "[", "]"}], "<", 
       RowBox[{"Min", "[", 
        RowBox[{"1", ",", 
         RowBox[{
          RowBox[{"mypdf", "[", "xnew", "]"}], "/", 
          RowBox[{"mypdf", "[", 
           RowBox[{"xmu", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xmu", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", "xnew"}], ",", " ", 
      RowBox[{
       RowBox[{"xmu", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
       RowBox[{"xmu", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9828745579883423`*^9, 3.982874559621924*^9}, {
  3.982874895870121*^9, 3.982874929962472*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"d7b826aa-e606-45f7-9536-ba6d9ee81058"],

