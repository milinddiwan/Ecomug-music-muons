Notebook[{

Cell[CellGroupData[{
Cell["\<\
This notebook is for providing the flux of cosmic ray muons at shallow \
depths. It starts with the parametrization according to ECoMUG. We will use \
the fit from EcoMug to perform the calculation.  EcoMug: An Efficient COsmic \
MUon Generator for cosmic-ray muon applications. D. Pagano et al.,  NIM A \
1014 (2021) 165732\
\>", "Section",
 CellChangeTimes->{{3.9881003306630783`*^9, 
  3.9881003676249447`*^9}},ExpressionUUID->"89125e30-3faa-497d-a24a-\
ac1b39b9079c"],

Cell[CellGroupData[{

Cell["\<\
Here we setup some parameters.  These are for energy loss evaluation.  For \
shallow depth.   Simply use the formula   E_mu(x) = E_mu(0) - apar * X  
Now for apar use the value that is average of  values at 10 and 100 GeV.  The \
differential spectrum remains the same, but it is simply shifted in this 1 \
dimensional calculation.  x is the depth.  
Units are as follows 
Energy in GeV,  
range in km.w.e, 
apar  in MeV/gm/cm^2, \[LineSeparator]bpar in 10^(-6)/gm/cm^2 \
\>", "Subsection",
 CellChangeTimes->{{3.988100418978702*^9, 3.988100424390867*^9}, {
  3.9881004741237783`*^9, 3.988100484225568*^9}, {3.9881005286133137`*^9, 
  3.988100583548113*^9}, {3.988100616417735*^9, 
  3.988100660715713*^9}},ExpressionUUID->"9bc1870e-9cda-4c6c-a773-\
8de946a8f403"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Emutab", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"10", ",", " ", "100", ",", " ", "1000", ",", " ", "10000"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rangtab", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.05", ",", "0.41", ",", " ", "2.45", ",", " ", "6.09"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"apar", " ", "=", 
    RowBox[{"{", 
     RowBox[{"2.17", ",", "2.44", ",", " ", "2.68", ",", " ", "2.93"}], 
     "}"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bbrems", " ", "=", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"0.7", ",", " ", "1.1", ",", " ", "1.44", ",", " ", "1.62"}], 
     "}"}], "*", 
    RowBox[{"10", "^", 
     RowBox[{"-", "6"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bpair", " ", "=", 
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{"0.7", ",", " ", "1.53", ",", " ", "2.07", ",", " ", "2.27"}], 
      "}"}], "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bnucl", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0.5", ",", "0.41", ",", "0.41", ",", "0.46"}], "}"}], "*", 
    RowBox[{"10", "^", 
     RowBox[{"-", "6"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bpar", "=", " ", 
    RowBox[{"bbrems", "+", "bpair", "+", "bnucl"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bice", " ", "=", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.66", ",", "2.51", ",", " ", "3.17", ",", " ", "3.78"}], 
      "}"}], "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}]}], ";"}], 
  "  "}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.988100459233034*^9, 3.988100471243544*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"5d899a08-a17f-4f24-b268-65e2df594b64"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Formula for the ECOMUG fit.  The formula arguments are   pmu in GeV/c is the \
momentum of the cosmic muon, and x = Cos(th) is the cosine of the zenith \
angle. The output is in units of   flux per m^2 per second per steradians at \
the specified angle.  \
\>", "Subsection",
 CellChangeTimes->{{3.988102421589036*^9, 3.9881024238144827`*^9}, {
   3.988102460492271*^9, 3.988102465650238*^9}, {3.988103297034313*^9, 
   3.98810335448348*^9}, {3.988103515751912*^9, 3.988103541278659*^9}, 
   3.9881893527786694`*^9},ExpressionUUID->"9138e73c-e2fd-4d27-a41f-\
4d32212c2386"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dalt", "[", 
     RowBox[{"pmu_", ",", " ", "x_"}], "]"}], ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"npo", ",", " ", "tmp"}], " ", "}"}], ",", " ", 
      RowBox[{
       RowBox[{"npo", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"0.1", ",", " ", 
          RowBox[{"2.856", "-", 
           RowBox[{"0.655", 
            RowBox[{"Log", "[", "pmu", "]"}]}]}]}], "]"}]}], ";", "  ", 
       RowBox[{"tmp", " ", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1600", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"pmu", " ", "+", " ", "2.68"}], ")"}], "^", 
            RowBox[{"-", "3.175"}]}], " ", "*", " ", 
           RowBox[{
            RowBox[{"(", "pmu", ")"}], "^", "0.279"}]}], ")"}], "*", 
         RowBox[{"x", "^", "npo"}]}]}], " ", ";", " ", 
       RowBox[{"Return", "[", "tmp", "]"}]}]}], "]"}]}], " ", ";"}], 
  " "}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"386bc573-e508-4c85-b006-11096a9bbbd5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"p2", " ", "=", " ", 
  RowBox[{"LogLogPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dalt", "[", 
       RowBox[{"emu", ",", "1"}], "]"}], ",", 
      RowBox[{"dalt", "[", 
       RowBox[{"emu", ",", "0.25"}], "]"}]}], "}"}], " ", ",", 
    RowBox[{"{", 
     RowBox[{"emu", ",", "0.1", ",", " ", "20000"}], "}"}], ",", " ", 
    RowBox[{"Frame", " ", "->", " ", "True"}], " ", ",", " ", 
    RowBox[{"LabelStyle", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"Bold", ",", " ", "Large", ",", " ", "Italic"}], "}"}]}], " ", ",",
     " ", 
    RowBox[{"FrameLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<energy GeV\>\"", ",", 
       " ", "\"\<Muons m^-2 sr^-1 sec^-1 GeV^-1\>\""}], " ", "}"}]}], ",", 
    " ", 
    RowBox[{"PlotStyle", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"Red", ",", " ", "Dashed"}], "}"}]}]}], " ", "]"}]}]], "Input",
 CellChangeTimes->{{3.988190114310973*^9, 3.988190116002572*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"4477c6c3-455a-4260-a236-ac24eb029b5b"],

